PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX pr: <http://www.wikidata.org/prop/reference/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT
  ?wikidata_id
  ?glottocode
  ?jurisdiction_id
  ?jurisdiction_name
  ?iso3166_1
  ?statement_id
  ?applies_to_part_id
  ?applies_to_part_name
  ?start_time
  ?end_time
  ?rank
  ?stated_in_id
  ?stated_in_name
  ?reference_url
  ?retrieved
WHERE {
  ?language wdt:P1394 ?glottocode .
  FILTER(REGEX(STR(?glottocode), "^[a-z]{4}[0-9]{4}$"))
  ?jurisdiction p:P37 ?statement .
  # Restrict the broad P37 domain to countries and territories. Without this,
  # organizations, municipalities, schools, and other entities dominate.
  ?jurisdiction wdt:P297 ?iso3166_1 .
  ?statement ps:P37 ?language ;
             wikibase:rank ?rank_uri .

  BIND(REPLACE(STR(?language), "^.*/", "") AS ?wikidata_id)
  BIND(REPLACE(STR(?jurisdiction), "^.*/", "") AS ?jurisdiction_id)
  BIND(REPLACE(STR(?statement), "^.*/", "") AS ?statement_id)
  BIND(
    IF(?rank_uri = wikibase:PreferredRank, "preferred",
      IF(?rank_uri = wikibase:DeprecatedRank, "deprecated", "normal"))
    AS ?rank
  )

  OPTIONAL {
    ?jurisdiction rdfs:label ?jurisdiction_name .
    FILTER(LANG(?jurisdiction_name) = "en")
  }
  OPTIONAL {
    ?statement pq:P518 ?applies_to_part .
    BIND(REPLACE(STR(?applies_to_part), "^.*/", "") AS ?applies_to_part_id)
    OPTIONAL {
      ?applies_to_part rdfs:label ?applies_to_part_name .
      FILTER(LANG(?applies_to_part_name) = "en")
    }
  }
  OPTIONAL { ?statement pq:P580 ?start_time . }
  OPTIONAL { ?statement pq:P582 ?end_time . }
  OPTIONAL {
    ?statement prov:wasDerivedFrom ?reference .
    OPTIONAL {
      ?reference pr:P248 ?stated_in .
      BIND(REPLACE(STR(?stated_in), "^.*/", "") AS ?stated_in_id)
      OPTIONAL {
        ?stated_in rdfs:label ?stated_in_name .
        FILTER(LANG(?stated_in_name) = "en")
      }
    }
    OPTIONAL { ?reference pr:P854 ?reference_url . }
    OPTIONAL { ?reference pr:P813 ?retrieved . }
  }
}
ORDER BY ?glottocode ?jurisdiction_id
