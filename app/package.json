{
  "name": "language-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "precompute:colors": "node scripts/precompute-colors.mjs",
    "precompute:branches": "node scripts/precompute-branches.ts",
    "precompute:parts": "node scripts/precompute-parts.ts",
    "benchmark:parts": "node scripts/benchmark-parts.ts",
    "test:branch-browser": "npm run build && python3 tests/browser/branches.py",
    "test:parts-browser": "npm run build && python3 tests/browser/parts.py",
    "test:browser": "python3 tests/browser/run.py",
    "test:inspection-browser": "python3 tests/browser/inspection.py",
    "test:catalog-browser": "npm run build && python3 tests/browser/catalog.py",
    "test:selection-browser": "npm run build && python3 tests/browser/selection.py",
    "test:focus-browser": "npm run build && python3 tests/browser/focus.py",
    "test:prepared-colors-browser": "npm run build && python3 tests/browser/prepared_colors.py",
    "test:colors-browser": "python3 -m unittest discover -s tests/browser -p test_color_evaluation.py && npm run build && python3 tests/browser/colors.py",
    "evaluate:colors": "python3 tests/browser/color_evaluation.py",
    "test:source-browser": "npm run build && python3 tests/browser/source_languoids.py",
    "test:geometry-browser": "npm run build && python3 tests/browser/geometry.py",
    "test:delivery-browser": "npm run build && python3 tests/browser/delivery.py",
    "test:prepared-browser": "npm run build && python3 tests/browser/prepared.py",
    "test:coverage-browser": "npm run build && python3 tests/browser/coverage.py",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "test:etymology-snapshot": "node --test --test-isolation=none tests/integration/etymology.test.ts",
    "test:wals-snapshot": "node --test --test-isolation=none tests/integration/wals.test.ts",
    "test:explorer-navigation-browser": "python3 tests/browser/explorer_navigation.py",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test:etymology-browser": "npm run build && python3 tests/browser/etymology.py",
    "test:word-trail-browser": "npm run build && python3 tests/browser/word_trail.py",
    "test:coverage-selection-browser": "npm run build && python3 tests/browser/coverage_selection.py",
    "measure:etymology-browser": "npm run build && python3 tests/browser/etymology_performance.py"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/vt-pbf": "4.3.2",
    "@tanstack/react-virtual": "^3.14.21",
    "culori": "^4.0.2",
    "geos-wasm": "3.1.1",
    "jotai": "^3.0.1",
    "maplibre-gl": "6.14.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "rbush": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.3",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
