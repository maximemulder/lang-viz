{
  "name": "language-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "precompute:colors": "node scripts/precompute-colors.mjs",
    "precompute:branches": "node scripts/precompute-branches.ts",
    "precompute:parts": "node scripts/precompute-parts.ts",
    "benchmark:parts": "node scripts/benchmark-parts.ts",
    "test:branch-browser": "npm run build && python3 -m tests.browser.branches",
    "test:parts-browser": "npm run build && python3 -m tests.browser.parts",
    "test:browser": "python3 -m tests.browser.run",
    "test:inspection-browser": "python3 -m tests.browser.inspection",
    "test:catalog-browser": "npm run build && python3 -m tests.browser.catalog",
    "test:selection-browser": "npm run build && python3 -m tests.browser.selection",
    "test:focus-browser": "npm run build && python3 -m tests.browser.focus",
    "test:prepared-colors-browser": "npm run build && python3 -m tests.browser.prepared_colors",
    "test:colors-browser": "python3 -m unittest tests.browser.test_color_evaluation && npm run build && python3 -m tests.browser.colors",
    "evaluate:colors": "python3 -m tests.browser.color_evaluation",
    "test:source-browser": "npm run build && python3 -m tests.browser.source_languoids",
    "test:geometry-browser": "npm run build && python3 -m tests.browser.geometry",
    "test:delivery-browser": "npm run build && python3 -m tests.browser.delivery",
    "test:prepared-browser": "npm run build && python3 -m tests.browser.prepared",
    "test:coverage-browser": "npm run build && python3 -m tests.browser.coverage",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "test:etymology-snapshot": "node --test --test-isolation=none tests/integration/etymology.test.ts",
    "test:wals-snapshot": "node --test --test-isolation=none tests/integration/wals.test.ts",
    "review:wals-examples": "node scripts/review-wals-examples.ts",
    "test:wals-profile-browser": "python3 -m tests.browser.wals_profile",
    "test:wals-map-browser": "python3 -m tests.browser.wals_map",
    "measure:wals": "node scripts/measure-wals.ts",
    "measure:wals-browser": "GITHUB_PAGES=true npm run build && python3 -m tests.browser.wals_performance",
    "test:explorer-navigation-browser": "python3 -m tests.browser.explorer_navigation",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test:etymology-browser": "npm run build && python3 -m tests.browser.etymology",
    "test:word-trail-browser": "npm run build && python3 -m tests.browser.word_trail",
    "test:coverage-selection-browser": "npm run build && python3 -m tests.browser.coverage_selection",
    "measure:etymology-browser": "npm run build && python3 -m tests.browser.etymology_performance"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/vt-pbf": "4.3.2",
    "@tanstack/react-virtual": "^3.14.21",
    "culori": "^4.0.2",
    "geos-wasm": "3.1.1",
    "jotai": "^3.0.1",
    "maplibre-gl": "6.14.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "rbush": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.3",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
